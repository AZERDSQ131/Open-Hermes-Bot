{
  "expo": {
    "name": "Hermes Bot",
    "slug": "hermes-bot-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1d1d1f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hermesbot.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Hermes Bot reads the pairing code the desktop app shows. Nothing else uses the camera."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hermes Bot listens to your voice to write the message.",
          "speechRecognitionPermission": "Hermes Bot transcribes your dictation on this phone, never on a server."
        }
      ]
    ]
  }
}
