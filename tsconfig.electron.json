{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "electron/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": [
    "electron/**/*.test.js",
    "scripts/**/*.test.js"
  ]
}