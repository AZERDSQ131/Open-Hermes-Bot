{
  "name": "grok-bot",
  "productName": "Grok Bot",
  "version": "1.0.0",
  "description": "A dark, native-feeling macOS chat app for AI agents.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -s first \"vite --port 5199 --strictPort\" \"wait-on http-get://localhost:5199 && VITE_DEV_SERVER_URL=http://localhost:5199 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  }
}
